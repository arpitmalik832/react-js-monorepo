{
  "name": "react-js-monorepo",
  "version": "0.0.0",
  "description": "A React JS starter code",
  "type": "module",
  "author": "Arpit Malik",
  "license": "MIT",
  "engines": {
    "node": ">=20.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitmalik832/react-js-monorepo.git"
  },
  "scripts": {
    "preinstall": "if [ \"$SKIP_PREINSTALL\" != \"true\" ]; then node -e \"if(process.env.npm_execpath.indexOf('pnpm') === -1) throw new Error('You must use pnpm to install dependencies')\"; else echo 'Skipping preinstall script'; fi",
    "rm-node_modules": "rimraf '**/node_modules' --glob",
    "rm-pnpm-lock": "rimraf pnpm-lock.yaml",
    "clean": "nx reset && pnpm rm-pnpm-lock && pnpm rm-node_modules",
    "build:apps": "nx run-many --target=build --projects=\"*_proj\"",
    "build:apps:beta": "nx run-many --target=build:beta --projects=\"*_proj\"",
    "build:apps:prod": "nx run-many --target=build:prod --projects=\"*_proj\"",
    "build:pkg": "nx run-many --target=build --projects=\"@arpitmalik832/*\"",
    "build:pkg:beta": "nx run-many --target=build:beta --projects=\"@arpitmalik832/*\"",
    "build:pkg:prod": "nx run-many --target=build:prod --projects=\"@arpitmalik832/*\"",
    "build:test-apps": "nx run-many --target=build --projects=\"*_test\"",
    "build:test-apps:beta": "nx run-many --target=build:beta --projects=\"*_test\"",
    "build:test-apps:prod": "nx run-many --target=build:prod --projects=\"*_test\"",
    "build": "pnpm build:pkg && pnpm build:test-apps && pnpm build:apps",
    "build:beta": "pnpm build:pkg:beta && pnpm build:test-apps:beta && pnpm build:apps:beta",
    "build:prod": "pnpm build:pkg:prod && pnpm build:test-apps:prod && pnpm build:apps:prod",
    "flow:check": "nx run-many --target=flow:check --all",
    "flow:check-all": "nx run-many --target=flow:check-all --all",
    "flow:status": "nx run-many --target=flow:status --all",
    "lint-js:self": "eslint --quiet",
    "lint-js:self:debug": "eslint --debug",
    "lint-js:self:print-config": "eslint --print-config eslintConfigProcessed.js",
    "prettier:self": "prettier --check",
    "lint:self": "pnpm lint-js:self \"**/*.{mjs,cjs,js,jsx,mdx}\" && pnpm prettier:self .",
    "lint-js:self:fix": "pnpm lint-js:self --fix",
    "prettier:self:fix": "prettier --write --ignore-unknown",
    "lint:self:fix": "pnpm lint-js:self:fix \"**/*.{mjs,cjs,js,jsx,mdx}\" && pnpm prettier:self:fix .",
    "lint-tsc": "nx run-many --target=lint:tsc --all",
    "lint": "nx run-many --target=lint --all && pnpm lint:self",
    "lint:fix": "nx run-many --target=lint:fix --all && pnpm lint:self:fix",
    "lint-staged": "nx run-many --target=lint-staged --all --parallel=1",
    "grant-permissions:husky": "chmod +x .husky/* && chmod +x git-hooks",
    "prepare": "husky && pnpm grant-permissions:husky",
    "commit": "git-cz",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test:watch --all",
    "test:ss-update": "nx run-many --target=test:ss-update --all",
    "test:coverage": "nx run-many --target=test:coverage --all",
    "test:clearCache": "nx run-many --target=test:clearCache --all",
    "test:watch:quick": "nx run-many --target=test:watch:quick --all",
    "test:watch:inBand": "nx run-many --target=test:watch:inBand --all",
    "test:coverage:silent": "nx run-many --target=test:coverage:silent --all",
    "test:coverage:quick": "nx run-many --target=test:coverage:quick --all",
    "test:coverage:inBand": "nx run-many --target=test:coverage:inBand --all",
    "test:coverage:silent:quick": "nx run-many --target=test:coverage:silent:quick --all",
    "test:coverage:silent:inBand": "nx run-many --target=test:coverage:silent:inBand --all",
    "e2e-open": "nx run-many --target=e2e-open --all",
    "e2e-run": "nx run-many --target=e2e-run --all",
    "e2e-open-all": "nx run-many --target=e2e-open-all --all",
    "e2e-run-all": "nx run-many --target=e2e-run-all --all",
    "e2e-run:pre-commit": "nx affected --target=e2e-run:pre-commit",
    "knip": "nx run-many --target=knip --all",
    "knip:debug": "nx run-many --target=knip:debug --all",
    "knip:check-files": "nx run-many --target=knip:check-files --all",
    "knip:w/o-devDependencies": "nx run-many --target=knip:w/o-devDependencies --all",
    "knip:prod": "nx run-many --target=knip:prod --all",
    "knip:prod:check-files": "nx run-many --target=knip:prod:check-files --all",
    "storybook:build:apps": "nx run-many --target=storybook:build --projects=\"*_proj\"",
    "storybook:build:apps:beta": "nx run-many --target=storybook:build:beta --projects=\"*_proj\"",
    "storybook:build:apps:prod": "nx run-many --target=storybook:build:prod --projects=\"*_proj\"",
    "storybook:build:pkg": "nx run-many --target=storybook:build --projects=\"@arpitmalik832/*\"",
    "storybook:build:pkg:beta": "nx run-many --target=storybook:build:beta --projects=\"@arpitmalik832/*\"",
    "storybook:build:pkg:prod": "nx run-many --target=storybook:build:prod --projects=\"@arpitmalik832/*\"",
    "storybook:build:test-apps": "nx run-many --target=storybook:build --projects=\"*_test\"",
    "storybook:build:test-apps:beta": "nx run-many --target=storybook:build:beta --projects=\"*_test\"",
    "storybook:build:test-apps:prod": "nx run-many --target=storybook:build:prod --projects=\"*_test\"",
    "storybook:build": "pnpm storybook:build:pkg && pnpm storybook:build:test-apps && pnpm storybook:build:apps",
    "storybook:build:beta": "pnpm storybook:build:pkg:beta && pnpm storybook:build:test-apps:beta && pnpm storybook:build:apps:beta",
    "storybook:build:prod": "pnpm storybook:build:pkg:prod && pnpm storybook:build:test-apps:prod && pnpm storybook:build:apps:prod",
    "version-bump:major:release": "semantic-release --release-type major",
    "version-bump:minor:release": "semantic-release --release-type minor",
    "version-bump:patch:release": "semantic-release --release-type patch",
    "version-bump:major:alpha": "semantic-release --release-type major --prerelease alpha",
    "version-bump:minor:alpha": "semantic-release --release-type minor --prerelease alpha",
    "version-bump:patch:alpha": "semantic-release --release-type patch --prerelease alpha",
    "version-bump:major:beta": "semantic-release --release-type major --prerelease beta",
    "version-bump:minor:beta": "semantic-release --release-type minor --prerelease beta",
    "version-bump:patch:beta": "semantic-release --release-type patch --prerelease beta",
    "version-bump:major:rc": "semantic-release --release-type major --prerelease rc",
    "version-bump:minor:rc": "semantic-release --release-type minor --prerelease rc",
    "version-bump:patch:rc": "semantic-release --release-type patch --prerelease rc",
    "version-bump:dry-run": "semantic-release --dry-run",
    "version-bump:debug": "DEBUG=semantic-release:* semantic-release"
  },
  "devDependencies": {
    "@arpitmalik832/eslint-config": "1.0.0-alpha.2",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/cz-commitlint": "^19.6.1",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.21.0",
    "@nx/workspace": "^18.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "commitizen": "^4.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "nx": "^18.0.0",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.3",
    "validate-branch-name": "^1.3.2"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@arpitmalik832/eslint-config",
      "@bundled-es-modules/glob",
      "@parcel/watcher",
      "@swc/core",
      "core-js",
      "core-js-pure",
      "cypress",
      "esbuild",
      "nx",
      "style-dictionary",
      "typesense-instantsearch-adapter"
    ]
  }
}
